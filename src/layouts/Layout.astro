---
import "../styles/app.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Clients",
  description = "Gestion géographique des clients",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
