---
import SignIn from "../../node_modules/auth-astro/src/components/SignIn.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Connexion | Clients"
  description="Connectez-vous à votre espace de gestion des clients."
>
  <main class="login-page">
    <section class="login-card" aria-labelledby="login-title">
      <a class="back-link" href="/" aria-label="Retour à l'accueil">
        <span aria-hidden="true">←</span>
        Retour à l'accueil
      </a>

      <div class="login-brand" aria-hidden="true">📍</div>

      <p class="eyebrow">Espace sécurisé</p>
      <h1 id="login-title">Bienvenue</h1>
      <p class="login-description">
        Connectez-vous pour accéder à votre tableau de bord clients.
      </p>

      <SignIn
        provider="google"
        class="google-button"
      >
        <span class="google-icon" aria-hidden="true">G</span>
        Se connecter avec Google
        <span aria-hidden="true">→</span>
      </SignIn>

      <p class="login-help">
        La connexion est sécurisée par Google.
      </p>
    </section>
  </main>
</Layout>

<style>
  :global(body) {
    min-height: 100vh;
    background:
      radial-gradient(circle at 12% 15%, rgba(129, 140, 248, 0.22), transparent 30%),
      radial-gradient(circle at 88% 85%, rgba(99, 102, 241, 0.16), transparent 32%),
      #f5f7fb;
  }

  .login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 32px 20px;
  }

  .login-card {
    width: min(100%, 430px);
    padding: 34px;
    border: 1px solid #e3e8f3;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 24px 70px rgba(30, 41, 59, 0.12);
    text-align: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    align-self: flex-start;
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #4f46e5;
  }

  .login-brand {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    margin: 28px auto 20px;
    border-radius: 18px;
    background: #4f46e5;
    color: white;
    font-size: 26px;
    box-shadow: 0 12px 24px rgba(79, 70, 229, 0.25);
  }

  .eyebrow {
    margin: 0 0 8px;
    color: #4f46e5;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #172033;
    font-size: clamp(28px, 6vw, 36px);
    letter-spacing: -0.04em;
  }

  .login-description {
    max-width: 310px;
    margin: 12px auto 28px;
    color: #718096;
    font-size: 14px;
    line-height: 1.6;
  }

  .google-button {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 16px;
    border: 1px solid #d8deea;
    border-radius: 12px;
    background: white;
    color: #273248;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 5px 15px rgba(30, 41, 59, 0.06);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .google-button:hover {
    border-color: #a5b4fc;
    box-shadow: 0 9px 22px rgba(79, 70, 229, 0.14);
    transform: translateY(-1px);
  }

  .google-icon {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    color: #4285f4;
    font-size: 17px;
    font-weight: 800;
  }

  .login-help {
    margin: 22px 0 0;
    color: #94a3b8;
    font-size: 12px;
  }

  @media (max-width: 480px) {
    .login-page {
      padding: 20px 14px;
    }

    .login-card {
      padding: 28px 22px;
      border-radius: 20px;
    }
  }
</style>
